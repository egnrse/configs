# ~/.config/hyprswitch/args.env
#
# override settings file for '/etc/default/hyprswitch'
# Will be launched like: /usr/bin/hyprswitch $HYPRSWITCH_OPTIONS init $HYPRSWITCH_ARGS
HYPRSWITCH_OPTIONS="-v"
HYPRSWITCH_ARGS="--show-title --size-factor 6 --workspaces-per-row 3 --custom-css /home/elia/.config/hyprswitch/style.css"

